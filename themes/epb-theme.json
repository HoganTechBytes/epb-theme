{
  "name": "Electric Purple Black",
  "type": "dark",
  "colors": {
    "focusBorder": "#AA00FF",
    "editor.background": "#000000",
    "editor.foreground": "#B58DFF",
    "editorBracketMatch.border": "#AA00FF",
    "editorBracketMatch.background": "#2E1446",
    "editorCursor.foreground": "#AA00FF",
    "editorCursor.background": "#000000",
    "editor.selectionForeground": "#E6D7FF",
    "editor.selectionBackground": "#0F2A3D",
    "editor.selectionBorder": "#AA00FF",
    "editor.inactiveSelectionBackground": "#241033",
    "editor.findMatchBackground": "#3A1A5A",
    "editor.findMatchHighlightBackground": "#2E1446",
    "editor.findRangeHighlightBackground": "#241033",
    "editor.selectionHighlightBackground": "#2E1446",
    "editor.wordHighlightBackground": "#241033",
    "editor.wordHighlightStrongBackground": "#3A1A5A",
    "editor.lineHighlightBackground": "#241033",
    "editorLineNumber.foreground": "#6F4A99",
    "editorLineNumber.activeForeground": "#B58DFF",
    "editorIndentGuide.background1": "#1A0D26",
    "editorIndentGuide.activeBackground1": "#2E1446",
    "editorWhitespace.foreground": "#1A0D26",
    "sideBar.background": "#000000",
    "sideBar.foreground": "#B58DFF",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#AA00FF",
    "activityBar.inactiveForeground": "#6F4A99",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#B58DFF",
    "statusBar.debuggingBackground": "#000000",
    "statusBar.debuggingForeground": "#FFB84D",
    "panel.background": "#000000",
    "panel.border": "#120A1A",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#B58DFF",
    "titleBar.inactiveBackground": "#000000",
    "titleBar.inactiveForeground": "#6F4A99",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#B58DFF",
    "tab.inactiveBackground": "#000000",
    "tab.inactiveForeground": "#6F4A99",
    "tab.border": "#120A1A",
    "terminal.background": "#000000",
    "terminal.foreground": "#B58DFF",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#FF5C8A",
    "terminal.ansiGreen": "#5CFFB3",
    "terminal.ansiYellow": "#FFB84D",
    "terminal.ansiBlue": "#6CA0FF",
    "terminal.ansiMagenta": "#AA00FF",
    "terminal.ansiCyan": "#5FB3C2",
    "terminal.ansiWhite": "#B58DFF",
    "terminal.ansiBrightBlack": "#120A1A",
    "terminal.ansiBrightRed": "#FF8FB0",
    "terminal.ansiBrightGreen": "#8AFFCB",
    "terminal.ansiBrightYellow": "#FFD89A",
    "terminal.ansiBrightBlue": "#9FC0FF",
    "terminal.ansiBrightMagenta": "#C566FF",
    "terminal.ansiBrightCyan": "#7FCBD6",
    "terminal.ansiBrightWhite": "#E6D7FF"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6F4A99"
      }
    },
    {
      "name": "Keywords / control flow",
      "scope": [
        "storage.modifier",
        "keyword.control",
        "keyword.other",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#AA00FF"
      }
    },
    {
      "name": "Storage types",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#C566FF"
      }
    },
    {
      "name": "Functions / methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.method",
        "support.method",
        "variable.function"
      ],
      "settings": {
        "foreground": "#3A66CC"
      }
    },
    {
      "name": "Types / classes / interfaces",
      "scope": [
        "entity.name.type",
        "support.type",
        "storage.type.class",
        "entity.name.class",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#C566FF"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#5FB3C2"
      }
    },
    {
      "name": "Numbers / constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#5CFFB3"
      }
    },
    {
      "name": "Variables / identifiers (keep purple-forward)",
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#B58DFF"
      }
    },
    {
      "name": "Operators / punctuation (subtle)",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#6F4A99"
      }
    },
    {
      "name": "Invalid / errors",
      "scope": [
        "invalid",
        "invalid.illegal",
        "error"
      ],
      "settings": {
        "foreground": "#FF5C8A"
      }
    },
    {
      "name": "Python self (distinct)",
      "scope": [
        "variable.language.special.self.python",
        "variable.parameter.function.language.special.self.python"
      ],
      "settings": {
        "foreground": "#C566FF",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#C566FF",
    "type": "#C566FF",
    "interface": "#C566FF",
    "enum": "#C566FF",
    "typeParameter": "#C566FF",
    "function": "#3A66CC",
    "method": "#3A66CC",
    "parameter": "#B58DFF",
    "variable": "#B58DFF",
    "property": "#B58DFF",
    "namespace": "#B58DFF"
  }
}